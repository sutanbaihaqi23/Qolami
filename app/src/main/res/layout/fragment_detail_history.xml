<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.test.history.DetailHistoryFragment"
    android:background="#D0E3FF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="History"
        android:fontFamily="@font/nunitoextrabold"
        android:textColor="#015B8B"
        android:id="@+id/tv_text_history"
        android:layout_centerHorizontal="true"
        android:textSize="@dimen/_25ssp"
        android:layout_marginTop="@dimen/_10sdp"/>

    <ImageView
        android:id="@+id/ic_back_to_home_test"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:src="@drawable/baseline_arrow_back_ios_24"
        app:tint="@color/black"
        android:layout_alignParentStart="true"
        android:layout_marginStart="@dimen/_13sdp"
        android:layout_marginTop="@dimen/_17sdp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tv_text_number_history"
        android:text="Attempts"
        android:fontFamily="@font/nunitoextrabold"
        android:textColor="#015B8B"
        android:textSize="@dimen/_20ssp"
        android:layout_below="@id/tv_text_history"
        android:layout_alignParentStart="true"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginStart="@dimen/_40sdp"
        />

    <TextView
        android:id="@+id/tv_text_finished"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_text_history"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_40sdp"
        android:fontFamily="@font/nunitoextrabold"
        android:text="Finished"
        android:textColor="#015B8B"
        android:textSize="@dimen/_20ssp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tv_finished"
        android:text="10 / 10"
        android:fontFamily="@font/nunitoextrabold"
        android:textColor="#015B8B"
        android:textSize="@dimen/_20ssp"
        android:layout_below="@id/tv_text_finished"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginEnd="@dimen/_50sdp"
        android:textAlignment="center"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tv_number_history"
        android:text="1"
        android:fontFamily="@font/nunitoextrabold"
        android:textColor="#015B8B"
        android:textSize="@dimen/_22ssp"
        android:layout_below="@id/tv_text_number_history"
        android:layout_alignParentStart="true"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginStart="@dimen/_73sdp"

        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tv_text_score"
        android:text="Score"
        android:fontFamily="@font/nunitoextrabold"
        android:textColor="#015B8B"
        android:textSize="@dimen/_20ssp"
        android:layout_below="@id/tv_finished"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/_10sdp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tv_score"
        android:text="Score"
        android:fontFamily="@font/nunitoextrabold"
        android:textColor="#015B8B"
        android:textSize="@dimen/_20ssp"
        android:layout_below="@id/tv_text_score"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/_5sdp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/rv_detail_history"
        android:layout_below="@id/tv_score"
        android:layout_marginTop="@dimen/_15sdp"/>

</RelativeLayout>