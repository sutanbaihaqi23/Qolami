<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_80sdp"
    android:background="@drawable/rounded_item_history"
    android:layout_margin="@dimen/_10sdp">

    <TextView
        android:id="@+id/tv_history_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Attempt to "
        android:textColor="@color/black"
        android:fontFamily="@font/nunitosemibold"
        android:textSize="@dimen/_12ssp"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_10sdp"
        />
    <TextView
        android:id="@+id/tv_finished"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Finished  "
        android:textColor="@color/black"
        android:fontFamily="@font/nunitosemibold"
        android:layout_below="@id/tv_history_number"
        android:textSize="@dimen/_12ssp"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_2sdp"/>
    <TextView
        android:id="@+id/tv_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Grade "
        android:textColor="@color/black"
        android:fontFamily="@font/nunitosemibold"
        android:layout_below="@id/tv_finished"
        android:textSize="@dimen/_12ssp"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_2sdp"/>

</RelativeLayout>