<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.test.history.ListHistoryFragment"
    android:background="#D0E3FF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tv_text_history"
        android:text="History"
        android:fontFamily="@font/nunitoextrabold"
        android:layout_centerHorizontal="true"
        android:textSize="@dimen/_23ssp"
        android:layout_marginTop="@dimen/_10sdp"/>
    <ImageView
        android:id="@+id/ic_back_to_home_test"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:src="@drawable/baseline_arrow_back_ios_24"
        app:tint="@color/black"
        android:layout_alignParentStart="true"
        android:layout_marginStart="@dimen/_13sdp"
        android:layout_marginTop="@dimen/_17sdp"
        />
    
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/rv_list_history"
        android:layout_below="@id/tv_text_history"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_marginEnd="@dimen/_5sdp"/>


</RelativeLayout>