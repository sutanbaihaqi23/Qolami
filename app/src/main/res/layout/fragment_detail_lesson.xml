<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.pelajaran.DetailLessonFragment"
    android:background="#015B8B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/relativeLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_270sdp"
            android:background="@drawable/bottom_rounded_layout">

            <ImageView
                android:id="@+id/ic_arrow_back_pelajaran"
                android:layout_width="@dimen/_23sdp"
                android:layout_height="@dimen/_23sdp"
                android:background="@drawable/round_arrow_back_24"
                android:backgroundTint="@color/black"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_marginTop="@dimen/_12sdp" />

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/title_lesson"
                android:text="Huruf Hijaiyah"
                android:fontFamily="@font/nunitoextrabold"
                android:textColor="#015B8B"
                android:textSize="@dimen/_21ssp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/_10sdp" />

            <ImageView
                android:id="@+id/imageViewHuruf"
                android:layout_width="@dimen/_120sdp"
                android:layout_height="@dimen/_120sdp"
                android:layout_marginBottom="16dp"
                android:scaleType="fitCenter"
                android:layout_below="@id/title_lesson"
                android:layout_centerHorizontal="true"
                app:tint="@color/black"
                android:layout_marginTop="@dimen/_35sdp"
                android:src="@drawable/alifarrow"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                />

            <ImageView
                android:id="@+id/ic_back_huruf"
                android:layout_width="@dimen/_45sdp"
                android:layout_height="@dimen/_45sdp"
                android:background="@drawable/arrowbackcirlcle"
                android:layout_toLeftOf="@id/imageViewHuruf"
                android:layout_centerVertical="true"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                />
            <ImageView
                android:id="@+id/ic_next_huruf"
                android:layout_width="@dimen/_45sdp"
                android:layout_height="@dimen/_45sdp"
                android:background="@drawable/arrownextcircle"
                android:layout_toRightOf="@id/imageViewHuruf"
                android:layout_centerVertical="true"/>

            <ImageView
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:id="@+id/ic_speaker"
                android:background="@drawable/ic_speaker"
                app:tint="@color/black"
                android:layout_toLeftOf="@id/tv_latin_huruf"
                android:layout_below="@id/imageViewHuruf"
                android:layout_marginEnd="@dimen/_37sdp"
                android:layout_marginTop="@dimen/_5sdp"
                />

            <TextView
                android:id="@+id/tv_latin_huruf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Huruf"
                android:fontFamily="@font/nunitoextrabold"
                android:textColor="#015B8B"
                android:textStyle="bold"
                android:textSize="@dimen/_30ssp"
                android:layout_centerHorizontal="true"
                android:layout_below="@id/imageViewHuruf"/>

            <ImageView
                android:id="@+id/btn_clear_lesson"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:src="@drawable/eraser"
                android:layout_toRightOf="@id/tv_latin_huruf"
                android:layout_below="@id/imageViewHuruf"
                android:layout_marginStart="@dimen/_30sdp"
                android:layout_marginTop="@dimen/_5sdp"
                />
        </RelativeLayout>


        <FrameLayout
            android:id="@+id/lesson_writing_layout"
            android:layout_width="@dimen/_260sdp"
            android:layout_height="@dimen/_200sdp"
            android:background="@drawable/rounded_layout"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/_15sdp">


            <ImageView
                android:id="@+id/gif_pelajaran"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:tint="@color/black"
                android:scaleType="fitXY"
                android:alpha="0.9"
                android:layout_marginTop="@dimen/_32sdp"/>

            <com.example.TugasAkhir.qolami.customview.DrawingView
                android:id="@+id/drawing_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/_5sdp"
                android:background="@android:color/transparent" />
        </FrameLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_practice"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginStart="@dimen/_20sdp"
            android:layout_marginEnd="@dimen/_20sdp"
            android:background="@drawable/rounded_layout"
            android:text="Practice"
            android:fontFamily="@font/nunitoextrabold"
            android:textSize="@dimen/_15ssp"
            android:textColor="#32B8FF"/>

        <TextView
            android:id="@+id/tv_accuracy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Accuracy"
            android:fontFamily="@font/nunitoextrabold"
            android:textColor="@color/white"
            android:textSize="@dimen/_17ssp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/_7sdp"/>
    </LinearLayout>
</ScrollView>